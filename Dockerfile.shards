FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN pip install \
    aiohttp==3.14.0 \
    boto3==1.43.24

COPY scripts/shard_byte_server.py /app/shard_byte_server.py

ENV SHARDS_DIR=/data/shards \
    PORT=8080

EXPOSE 8080

CMD ["python", "/app/shard_byte_server.py"]
