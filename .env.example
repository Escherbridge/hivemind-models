# Cloudflare R2 Storage Configuration
# Get these from your Cloudflare dashboard: https://dash.cloudflare.com/
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY=your_access_key_here
R2_SECRET_KEY=your_secret_key_here
R2_BUCKET_NAME=hivemind-models

# Public URL for CDN access (optional)
# This is the custom domain or R2.dev URL for your bucket
R2_PUBLIC_URL=https://models.your-domain.com

# Cloudflare CDN Configuration (for cache management)
# Required only if you want to purge CDN cache programmatically
CF_ZONE_ID=your_zone_id_here
CF_API_TOKEN=your_api_token_here
CDN_BASE_URL=https://models.your-domain.com

# HuggingFace Configuration (optional)
# Required for private models or to increase rate limits
HF_TOKEN=your_huggingface_token_here

# Modal Configuration (optional)
# Set these if deploying to Modal for GPU conversion
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret
