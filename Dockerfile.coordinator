# syntax=docker/dockerfile:1.6
#
# Dockerfile for the Granite expert coordinator service.
#
# This image bundles a CPU-only torch wheel, the lm_head matmul + tokenizer
# dependencies, and the two source files the coordinator needs to run:
#
#     scripts/expert_coordinator.py
#     scripts/_wire.py
#
# Build locally:
#     docker build -f Dockerfile.coordinator -t expert-coordinator .
#
# Run locally (with stub upstreams set via env):
#     docker run --rm -p 8080:8080 \
#         -e PORT=8080 \
#         -e EXPERT_US_WEST_URL=wss://expert-us-west.up.railway.app \
#         -e EXPERT_US_WEST_IDS=0-31 \
#         -e EXPERT_US_EAST_URL=wss://expert-us-east.up.railway.app \
#         -e EXPERT_US_EAST_IDS=16-47 \
#         -e EXPERT_EU_URL=wss://expert-eu.up.railway.app \
#         -e EXPERT_EU_IDS=0-15,32-63 \
#         -e HEAD_LOCAL_PATH=/app/cache/shard_head.safetensors \
#         expert-coordinator
#
# The image is intentionally slim: no CUDA, no llama.cpp, no model weights
# baked in. The head shard is downloaded from S3 at boot to /app/cache (or
# read from there if a Railway volume is attached and the file is already
# present from a previous boot).

FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/.hf_cache \
    TRANSFORMERS_NO_ADVISORY_WARNINGS=1

# System deps:
#   - build-essential is needed only if torch decides to compile something;
#     the CPU wheel does not, so we keep this minimal.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install python deps in a single layer for cache efficiency. The torch CPU
# wheel lives on the standard PyPI mirror under the +cpu tag; pinning to a
# known-good version keeps cold-boot reproducible.
RUN pip install --upgrade pip \
 && pip install \
        "aiohttp>=3.9,<4" \
        "websockets>=12,<14" \
        "numpy>=1.26,<3" \
        "safetensors>=0.4,<1" \
        "boto3>=1.34,<2" \
        "transformers>=4.40,<5" \
        "huggingface_hub>=0.20,<1" \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        "torch==2.3.1"

# Pre-warm the HF cache for the Granite-tiny tokenizer so first-boot cold
# does NOT need to download the tokenizer from the network. We pull only the
# tokenizer files (not weights).
ARG MODEL_ID=ibm-granite/granite-3.0-1b-a400m-instruct
RUN python -c "from transformers import AutoTokenizer; \
AutoTokenizer.from_pretrained('${MODEL_ID}')" || \
    echo "[warn] tokenizer prefetch failed; will retry at boot"

# Copy only the two source files this service needs. Keeping the image
# minimal makes redeploy diffs small and cold-start fast.
COPY scripts/_wire.py /app/scripts/_wire.py
COPY scripts/expert_coordinator.py /app/scripts/expert_coordinator.py

# Cache dir for the head shard. Railway can attach a persistent volume here
# so redeploys reuse the already-downloaded shard.
RUN mkdir -p /app/cache

ENV PORT=8080
EXPOSE 8080

CMD ["python", "scripts/expert_coordinator.py"]
